{
  "name": "first-drive",
  "private": true,
  "version": "0.9.43-dev.15",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "art:trees": "node scripts/bake-headland-grove.mjs",
    "art:road": "node scripts/art-proto/export-road.mjs",
    "art:blockout": "node scripts/art-proto/make.mjs",
    "art:roadlock": "node scripts/art-proto/export-road.mjs --roadlock --output art-prototype/output/roadlock-road-reference.json",
    "coast:shore": "node scripts/bake-coast-shore.mjs",
    "art:prepare": "node scripts/prepare-runtime-art.mjs",
    "predev": "npm run coast:shore && npm run art:prepare",
    "prebuild": "npm run coast:shore && npm run art:prepare"
  },
  "dependencies": {
    "html2canvas": "1.4.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "1.1.0",
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  }
}
